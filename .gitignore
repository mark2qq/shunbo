/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---- 顺播：本地构建产物 / 临时目录（不进版本库）----
# 出包产物与历史回退包：单包 43 MB、_prev 累计 650 MB+，发布走 Release 资产，不入库。
/dist/
*.apk
*.idsig
*.dex

# legacy 打包工作目录：aligned/unsigned/dex/class 全为生成物，累计约 2 GB。
/legacy/work*/
/legacy/single/
/legacy/build_report.json

# 平台构建缓存与本机路径
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/windows/flutter/ephemeral/
/windows/.dart_tool/
/__pycache__/

# 本地取证 / 分析 / 回收站
/.shots/
/.apk_analysis/
/.trash_build/

# 构建日志（含 .log.err 变体）
*.log.err
